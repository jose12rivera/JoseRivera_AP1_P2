@page "/Combos/Create"
@inject CombosServices combosServices
@inject ArticulosServices articulosServices
@inject NavigationManager navigationManager
@rendermode InteractiveServer
@inject ToastService toastService

<EditForm Model="combo" OnValidSubmit="Guardar">
    <DataAnnotationsValidator/>

    <div class="container">
        <div class="card shadow-lg mt-3">
            <div class="card-header text-center">
                <h5>Registros Combos</h5>
            </div>
            <div class="card-body">
                <div class="row align-content-end">
                    <div class="col-md-10 mb-4">
                        <label for="ComboId" class="form-label"><strong>ComboId:</strong></label>
                        <div class="input-group">
                            <div style="width: 40%; height; 1mm;">
                                <InputNumber @bind-Value="combo.ComboId" class="form-control" />
                            </div>
                        </div>
                    </div>
                    <div class="mb-4">
                        <label for="Fecha" class="form-label"><strong>Fecha:</strong></label>
                        <InputDate @bind-Value="combo.Fecha" class="form-control" />
                        <ValidationMessage For="@(()=>combo.Fecha)" />
                    </div>
                    <div class="mb-4">
                        <label for="Descripcion" class="form-label"><strong>Descripcion:</strong></label>
                        <InputText @bind-Value="combo.Descripcion" class="form-control" />
                        <ValidationMessage For="@(()=>combo.Descripcion)" />
                    </div>
                  
                    <div class="mb-4">
                        <label for="Precio" class="form-label"><strong>Precio:</strong></label>
                        <div class="input-group">
                            <span class="input-group-text">$</span> 
                            <InputNumber @bind-Value="combo.Precio" class="form-control" disabled />
                        </div>
                        <ValidationMessage For="@(() => combo.Precio)" />
                    </div>


                    <div class="mb-4">
                        <label for="Vendido" class="form-label"><strong>Vendido:</strong></label>
                        <InputText @bind-Value="combo.Vendido" class="form-control" />
                        <ValidationMessage For="@(()=>combo.Vendido)" />
                    </div>

                    <div class="border border-success mt-3">
                        <h5>Registros comboDetalle</h5>
                        <div class="card-body">
                            <div class="row align-items-end m-0">

                                <div class="col-md-4 p-0">
                                    <label for="ArticuloId" class="form-label"></label>
                                    <InputSelect @bind-Value="combosDetalle.ArticuloId" class="form-control">
                                        <option value="0" class="bold-option">Elejir un Articulo</option>
                                        @foreach (var articulo in ListaArticulo)
                                        {
                                            <option value="@articulo.ArticuloId">@articulo.Descripcion- Precio</option>
                                        }
                                    </InputSelect>

                                    <ValidationMessage For="@(()=>articulos.ArticuloId)" />
                                </div>
                                <div class="col-md-3 p-0">
                                    <label for="Cantidad" class="form-label"></label>
                                    <div class="input-group">
                                        <span class="input-group-text"><strong>Cantidad:</strong></span>
                                        <InputText @bind-Value="combosDetalle.Cantidad" class="form-control" />
                                    </div>
                                    <ValidationMessage For="@(()=>combosDetalle.Cantidad)" />
                                </div>
                               
                                <div class="col-md-2 p-0">
                                    <label for="Costo" class="form-label"></label>
                                    <div class="input-group">
                                        <span class="input-group-text"><strong>Costo:</strong>$</span>
                                        <InputNumber @bind-Value="combosDetalle.Costo" class="form-control" />
                                    </div>
                                    <ValidationMessage For="@(()=>combosDetalle.Costo)" />
                                    
                                </div>
                                <div class="col-md-1 p-0">
                                    <button type="button" @onclick="AgregarDetalle" class="btn btn-outline-success">
                                        <span class="bi bi-plus-square-fill-nav-menu mt-3"></span>
                                        Agregar
                                    </button>
                                </div>
                            </div>

                            <table class="table table-light table-bordered ">
                                <thead class="table table-striped text-center">
                                    <tr>
                                        <th>ArticuloId</th>
                                        <th>Cantidad</th>
                                        <th>Costo</th>

                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var detalle in ListacombosDetalle)
                                    {
                                        var descripcionArticulo = ListaArticulo
                                        .FirstOrDefault(a => a.ArticuloId == detalle.ArticuloId)?.Descripcion ?? "No encontrado";
                                        <tr>
                                            <td>@descripcionArticulo</td>
                                           
                                            <td>@detalle.Cantidad</td>
                                            <td>@string.Format("{0:C}", detalle.Costo)</td>

                                            <td class="text-center">
                                                <button type="button" @onclick="()=>EliminarDetalle(detalle)" class="btn btn-outline-danger">
                                                    <span class="bi bi-trash"></span>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="card-footer justify-content-center text-center">
                            <div class="btn-group">
                                <button type="button" @onclick="Nuevo" class="btn btn-outline-secondary">
                                    <span class="bi bi-plus mt-3"></span>
                                    Nuevo
                                </button>
                                <button type="submit" class="btn btn-outline-success">
                                    <span class="bi bi-floppy mt-3"></span>
                                    Guardar
                                </button>
                                <button type="button" @onclick="Volver" class="btn btn-outline-primary">
                                    <span class="bi bi-arrow-left"></span>
                                    Volver
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</EditForm>

@code {
    [Parameter]
    public int ComboId{ get; set; }
    public List<Articulos> ListaArticulo { get; set; } = new List<Articulos>();
    public Articulos? articulos { get; set; } = new Articulos();
    public List<Combos> ListaCombos { get; set; } = new List<Combos>();
    public Combos? combo { get; set; } = new Combos();
    public List<CombosDetalle> ListacombosDetalle { get; set; } = new List<CombosDetalle>();
    public CombosDetalle? combosDetalle { get; set; } = new CombosDetalle();
    private bool existe = false;

    public async Task Nuevo(){
        combo = new Combos();
        combosDetalle = new CombosDetalle();
        existe = false;
    }
    protected override async Task OnInitializedAsync()
    {
        ListaArticulo = await articulosServices.ListarArticulos();
    }
    public async Task AgregarDetalle()
    {
        if (!string.IsNullOrWhiteSpace(combosDetalle.Cantidad) && decimal.TryParse(combosDetalle.Cantidad, out decimal cantidadDecimal))
        {
            var NuevoDetalle = new CombosDetalle
                {
                    ComboId = combo.ComboId,
                    ArticuloId = combosDetalle.ArticuloId,
                    Cantidad = combosDetalle.Cantidad,
                    Costo = combosDetalle.Costo
                };

            
            ListacombosDetalle.Add(NuevoDetalle);
            combosDetalle = new CombosDetalle();

           
            ActualizarPrecioCombo();

            toastService.Notify(new(ToastType.Secondary, "Éxito", "Se agregó un detalle al combo."));
        }
        else
        {
            toastService.Notify(new(ToastType.Warning, "Error", "Cantidad inválida."));
        }
    }
   
    public async Task EliminarDetalle(CombosDetalle detalle)
    {
        ListacombosDetalle.Remove(detalle);  
        toastService.Notify(new(ToastType.Danger, "Éxito", "Se eliminó"));
    }


    public async Task<bool> Validar(){
        existe = await combosServices.Existe(combo.ComboId);
        return !existe;
    }
    public async Task ActualizarPrecioCombo()
    {
        
        combo.Precio = ListacombosDetalle.Sum(d =>
        {
           
            decimal cantidad = decimal.TryParse(d.Cantidad, out decimal cantidadDecimal) ? cantidadDecimal : 0;
            decimal costo = d.Costo ?? 0; 
            return cantidad * costo;
        });
    }
    public async Task Guardar(){
        combo.CombosDetalles=ListacombosDetalle;
        if(!await Validar()){
            return;
        }

        var guardado = await combosServices.Guardar(combo);
        if(guardado){
            toastService.Notify(new(ToastType.Success, "Existo", "Se Guardo"));
        }
    }
    public async Task Buscar(){
        existe = false;
        var encontrado = await combosServices.Buscar(combo.ComboId);
        if(encontrado !=null){
            combo = encontrado;
        }else{
            Nuevo();
        }
    }
    public async Task Volver(){
        toastService.Notify(new(ToastType.Primary, "Existo", "Ya volvio"));
        navigationManager.NavigateTo("/Combos/Index");
    }
   
}
